<Application
    x:Class="TarkovAssistant.Client.App"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ShutdownMode="OnMainWindowClose"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101416" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1A2023" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2B3438" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F5F3" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A9B3AF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#C8A96A" />
    </Application.Resources>
</Application>
