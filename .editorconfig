root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

dotnet_style_require_accessibility_modifiers = always:warning
dotnet_style_readonly_field = true:warning
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning

csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_primary_constructors = false:silent
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning
csharp_prefer_braces = true:warning

dotnet_diagnostic.IDE0040.severity = warning
dotnet_diagnostic.CA1062.severity = warning

[*.{json,yml,yaml,xml,csproj,props,targets,sln}]
indent_style = space
indent_size = 2

[*.sln]
indent_style = tab

# EF Core owns migration syntax; keep application analyzers focused on hand-written code.
[src/TarkovAssistant.Backend/Database/Migrations/*.cs]
generated_code = true
